<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_stock" targetNamespace="https://github.com/MatiScavuzzo91/tpi-stock-cereal">
<bpmn:collaboration id="Collab">
<bpmn:participant id="P_ext" name="Clientes, canjeadores y plantas de acondicionamiento (externos)"/>
<bpmn:participant id="P_emp" name="Empresa agrícola-ganadera" processRef="Proc"/>
<bpmn:messageFlow id="M1" name="Remito de entrega (venta, canje o planta)" sourceRef="T1" targetRef="P_ext"/>
</bpmn:collaboration>
<bpmn:process id="Proc" name="Registro y control de movimientos de cereal" isExecutable="false">
<bpmn:laneSet id="LS">
<bpmn:lane id="L_campo" name="Transportistas y equipos de campo">
<bpmn:flowNodeRef>S</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_asis" name="Asistente administrativo">
<bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_jefe" name="Jefaturas (usuarios clave)">
<bpmn:flowNodeRef>J1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>J2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_sis" name="Módulo de stock de cereal (sistema)">
<bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>J</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Movimiento físico de cereal"><bpmn:outgoing>F0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="T1" name="Completar remito o planilla"><bpmn:incoming>F0</bpmn:incoming><bpmn:outgoing>F1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T2" name="Revisar remito o planilla"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T3" name="Cargar movimiento en el sistema"><bpmn:incoming>F2</bpmn:incoming><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="S1" name="Validar datos obligatorios"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G1" name="¿Datos completos?"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G2" name="¿Tipo de movimiento?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="S5" name="Registrar entrada"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="S3" name="Calcular stock disponible en la ubicación"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G3" name="¿Stock suficiente?"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T4" name="Verificar discrepancia con campo"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G4" name="¿Error de carga?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="J1" name="Autorizar ajuste de inventario"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="S6" name="Registrar ajuste de inventario"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="S7" name="Registrar salida y, si es traslado, entrada vinculada"><bpmn:incoming>F15</bpmn:incoming><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="J" name=""><bpmn:incoming>F17</bpmn:incoming><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="S9" name="Recalcular stock por ubicación y cereal"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G6" name="¿Ubicación vaciada?"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E1" name="Stock actualizado"><bpmn:incoming>F21</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="T5" name="Comparar stock registrado y físico"><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G7" name="¿Desvío de hasta 0,5 %?"><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing><bpmn:outgoing>F25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E2" name="Ubicación conciliada"><bpmn:incoming>F24</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="J2" name="Analizar desvío y autorizar ajuste"><bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="S10" name="Registrar ajuste de inventario"><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E3" name="Desvío ajustado"><bpmn:incoming>F27</bpmn:incoming></bpmn:endEvent>
